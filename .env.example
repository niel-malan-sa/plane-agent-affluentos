APP_ROLE=all
# Use DATABASE_URL for split ingress/worker deployments.
# Leave DATABASE_URL blank only for local/dev or single-process APP_ROLE=all.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://plane-agent.affluentos.com
PLANE_BASE_URL=https://plane.affluentos.com
PLANE_CLIENT_ID=your-plane-client-id
PLANE_CLIENT_SECRET=your-plane-client-secret
PLANE_REDIRECT_URI=https://plane-agent.affluentos.com/oauth/callback
PLANE_WEBHOOK_SECRET=replace-with-plane-webhook-secret
# Declared bot capability matrix for runtime policy/audit. Configure the same permissions on the Plane app.
PLANE_OAUTH_SCOPES=agents.runs:read agents.run_activities:read agents.run_activities:write
PLANE_USER_OAUTH_SCOPES=profile:read
DATABASE_URL=
DATABASE_PATH=./data/plane-agent.sqlite
STATE_TTL_SECONDS=900
TOKEN_REFRESH_SKEW_SECONDS=300
# Required for APP_ROLE=all and APP_ROLE=worker. Not required for APP_ROLE=ingress.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_MAX_TOOL_STEPS=3
WORKER_POLL_INTERVAL_MS=1500
WORKER_CONCURRENCY=1
RUN_HEARTBEAT_INTERVAL_MS=8000
RUN_STALE_AFTER_MS=300000
ENABLE_AUTONOMOUS_WRITES=false
WRITE_KILL_SWITCH=false
MAX_WRITES_PER_RUN=5
PROJECT_ALLOWLIST=
PROJECT_BLOCKLIST=
EXTERNAL_AUTH_GITHUB_URL=
EXTERNAL_AUTH_DOCS_URL=
